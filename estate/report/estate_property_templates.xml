<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="report_offers_data">
        <t t-if="offers">
            <table class="table">
                <thead>
                    <tr>
                        <th>Price</th>
                        <th>Partner</th>
                        <th>Validity(Days)</th>
                        <th>Deadline</th>
                        <th>State</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="offers" t-as="offer">
                        <td>
                            <span t-field="offer.price"/>
                        </td>
                        <td>
                            <span t-field="offer.partner_id.name"/>
                        </td>
                        <td>
                            <span t-field="offer.validity"/>
                        </td>
                        <td>
                            <span t-field="offer.date_deadline"/>
                        </td>
                        <td>
                            <span t-field="offer.status"/>
                        </td>
                    </tr>
                </tbody>
            </table>
        </t>
        <t t-else="not offers">
            <div>
                <span>
                    No offers have been made yet :(
                </span>
            </div>
        </t>
    </template>
    
    <template id="report_seller_properties">
        <t t-foreach="docs" t-as="seller">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>
                            <strong>Salesman:</strong>
                            <span t-field="seller.name"/>
                        </h2>

                        <t t-foreach="seller.property_ids" t-as="property">
                            <div>
                                <strong>Expected Price: </strong>
                                <span t-field="property.expected_price"/>
                            </div>
                            <div>
                                <strong>Status:</strong>
                                <span t-field="property.state"/>
                            </div>
                            <t t-set="offers" t-value="property.mapped('offer_ids')"/>
                            <t t-call="estate.report_offers_data"/>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <template id="report_property_offers_inherit" inherit_id="report_property_offers">
        <xpath expr="//div[@id='property-state']" position="after">
            <div id="inherit_div">
                <strong>Extra field</strong>
                <span>Inherit Field</span>
            </div>
        </xpath>
    </template>

    <template id="report_property_offers">
        <t t-foreach="docs" t-as="property">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>
                            <span t-field="property.name"/>
                        </h2>
                        <div>
                            <strong>Salesman:</strong>
                            <span t-field="property.salesperson_id.name"/>
                        </div>
                        <div>
                            <strong>Expected Price: </strong>
                            <span t-field="property.expected_price"/>
                        </div>
                        <div id="property-state">
                            <strong>Status:</strong>
                            <span t-field="property.state"/>
                        </div>
                        <t t-set="offers" t-value="property.mapped('offer_ids')"/>

                        <t t-call="estate.report_offers_data"/>

                        <img t-att-src="'/report/barcode/QR/RealStateProperty-%s?width=600&amp;height=600' % property.id"
                            style="width:300px;height:300px;"
                            alt="Barcode"/>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
