<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="groups_privilege_real_estate" model="res.groups.privilege">
        <field name="name">Real Estate</field>
        <field name="category_id" ref="base.module_category_tutorials"/>
    </record>
    <record id="estate_group_user" model="res.groups">
        <field name="name">Agent</field>
        <field name="comment">Agent that sell estates.</field>
        <field name="privilege_id" ref="groups_privilege_real_estate"/>
        <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
    </record>
    <record id="estate_group_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="comment">Manager Real Estate.</field>
        <field name="implied_ids" eval="[(4, ref('estate_group_user'))]"/>
        <field name="privilege_id" ref="groups_privilege_real_estate"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="rule_agent" model="ir.rule">
        <field name="name">Rule agent</field>
        <field name="model_id" ref="model_estate_property"/>
        <!-- <field name="perm_read" eval="False"/> -->
        <field name="groups" eval="[Command.link(ref('estate_group_user'))]"/>
        <field name="domain_force">[
            '|', ('salesperson_id', '=', user.id),
                ('salesperson_id', '=', False)
        ]</field>
    </record>
    
    <record model="ir.rule" id="estate_property_company_rule">
        <field name="name">Appraisal Plan multi-company</field>
        <field name="model_id" ref="model_estate_property"/>
        <field name="domain_force">[
            '|', ('company_id', '=', False),
                ('company_id', 'in', company_ids)
        ]</field>
    </record>
</odoo>
